# Webhook de cadastro de marketing (n8n) que recebe os leads das LPs.
# Contrato e códigos de resposta: docs/Webhook Cadastro Marketing - Documentacao.md
#
# NÃO é obrigatória. A URL de produção já é o padrão no código
# (artifacts/api-server/src/routes/lead.ts, WEBHOOK_PADRAO):
#   https://webhook.fluencypass.com/webhook/integracao-lead-crm
#
# Defina esta variável só para sobrescrever o padrão — tipicamente para apontar
# na URL de teste, que só responde depois de clicar "Listen for test event" no
# canvas do n8n e aceita uma chamada por clique:
# N8N_LEAD_WEBHOOK_URL=https://n8n.fluencypass.com/webhook-test/integracao-lead-crm

# Postgres do workspace.
DATABASE_URL=
