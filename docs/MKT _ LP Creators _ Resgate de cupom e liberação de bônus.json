      "parameters": {
        "jsCode": "const state = $('Preparar Tentativa').first().json;\nconst resp = $input.first().json;\nconst status = resp.statusCode;\nconst httpOk = status >= 200 && status < 300;\nconst contact = httpOk && resp.body && resp.body.total > 0 ? resp.body.results[0] : null;\n\nreturn [{\n  json: {\n    ...state,\n    contact_found: !!contact,\n    hubspot_contact_id: contact ? contact.id : null,\n    contact_props: contact ? contact.properties : {},\n    search_error: httpOk ? null : { status, body: resp.body },\n  },\n}];"
