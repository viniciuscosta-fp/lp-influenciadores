      "parameters": {
        "jsCode": "// Ajustes do fluxo. Edite só este nó.\nconst CONFIG = {\n  sheet_id: 'COLE_AQUI_O_ID_DA_PLANILHA',\n  sheet_cupons: 'cupons',\n  sheet_resgates: 'resgates',\n\n  hubspot_prop_affiliate: 'affiliate_id',     // nome interno da propriedade de afiliado\n  hubspot_prop_curso: 'curso_extra',            // nome interno da propriedade do curso extra\n  hubspot_prop_curso_multi: false,              // true se a propriedade for multi-seleção\n  hubspot_prop_acquire_url: 'acquireurl',        // '' para não gravar\n  hubspot_prop_aulas_pendentes: '',              // '' para não gravar aulas pendentes no HubSpot\n\n  polling_max_tentativas: 3,                     // buscas no HubSpot antes de desistir\n  polling_intervalo_seg: 5,                      // espera entre buscas\n  timezone: 'America/Sao_Paulo',\n};\nreturn [{ json: CONFIG }];"
      },
      "id": "d571e96f-4ae1-4a36-b637-4b762fdfd977",
