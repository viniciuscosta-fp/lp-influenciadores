      "parameters": {
        "jsCode": "const s = $('Preparar PATCH').first().json;\nconst resp = $input.first().json;\nconst patch_ok = resp.statusCode >= 200 && resp.statusCode < 300;\nconst curso = s.beneficios.curso_extra;\nreturn [{\n  json: {\n    ...s,\n    patch_ok,\n    patch_status: resp.statusCode,\n    patch_error: patch_ok ? null : resp.body,\n    reason: patch_ok ? null : 'HUBSPOT_ERROR',\n    curso_status: curso.liberar ? 'released' : 'not_applicable',\n    aulas_status: s.aulas_status || 'not_applicable',\n  },\n}];"
