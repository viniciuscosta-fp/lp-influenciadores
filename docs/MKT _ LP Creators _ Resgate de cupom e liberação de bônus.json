    {
      "parameters": {
        "jsCode": "// Gera o objeto de decisão a partir da linha do cupom na planilha\nconst cfg = $('Config').first().json;\nconst state = $('Validar Payload').first().json;\n\nconst norm = (v) => String(v ?? '').trim().toUpperCase().replace(/\\s+/g, '');\nconst toBool = (v) => v === true || ['TRUE', 'VERDADEIRO', 'SIM', '1'].includes(norm(v));\nconst toInt = (v) => { const n = parseInt(String(v ?? '').trim(), 10); return Number.isFinite(n) ? n : null; };\nconst toISODate = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number') { // número serial de planilha\n    return new Date(Date.UTC(1899, 11, 30) + v * 86400000).toISOString().slice(0, 10);\n  }\n  const s = String(v).trim();\n  let m = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  if (m) return `${m[1]}-${m[2]}-${m[3]}`;\n  m = s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/);\n  if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;\n  return null;\n};\nconst fail = (http_status, reason, message, extra = {}) =>\n  [{ json: { ...state, ok: false, http_status, reason, message, ...extra } }];\n\nconst rows = $input.all().map(i => i.json).filter(r => norm(r.cupom));\nconst matches = rows.filter(r => norm(r.cupom) === state.cupom);\n\nif (matches.length === 0) return fail(404, 'COUPON_NOT_FOUND', 'Cupom não encontrado');\nif (matches.length > 1) return fail(422, 'COUPON_MISCONFIGURED', 'Cupom duplicado na planilha');\n\nconst row = matches[0];\nconst hoje = DateTime.now().setZone(cfg.timezone).toISODate();\nconst inicio = toISODate(row.data_inicio);\nconst validade = toISODate(row.data_validade);\nconst affiliate_id = String(row.affiliate_id ?? '').trim();\nconst liberaCurso = toBool(row.libera_curso_extra);\nconst cursoCodigo = String(row.curso_extra_codigo ?? '').trim();\nconst liberaAulas = toBool(row.libera_aulas_extras);\nconst qtdAulas = toInt(row.qtd_aulas_extras);\n\nconst decisao = {\n  affiliate_id,\n  beneficios: {\n    curso_extra: { liberar: liberaCurso, codigo: liberaCurso ? cursoCodigo : null },\n    aulas_extras: { liberar: liberaAulas, quantidade: liberaAulas ? qtdAulas : null },\n  },\n};\n\nif (!toBool(row.ativo)) return fail(422, 'COUPON_INACTIVE', 'Cupom inativo', decisao);\n\nconst problemas = [];\nif (!validade) problemas.push('data_validade ausente ou inválida');\nif (!affiliate_id) problemas.push('affiliate_id ausente');\nif (liberaCurso && !cursoCodigo) problemas.push('curso_extra_codigo ausente');\nif (liberaAulas && (!qtdAulas || qtdAulas < 1)) problemas.push('qtd_aulas_extras inválida');\nif (problemas.length) return fail(422, 'COUPON_MISCONFIGURED', problemas.join('; '), decisao);\n\nif (inicio && hoje < inicio) return fail(422, 'COUPON_NOT_STARTED', `Cupom válido a partir de ${inicio}`, decisao);\nif (hoje > validade) return fail(422, 'COUPON_EXPIRED', `Cupom expirou em ${validade}`, decisao);\n\nreturn [{ json: { ...state, ok: true, http_status: null, reason: null, message: null, ...decisao } }];"
      },
