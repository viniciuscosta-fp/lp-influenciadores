        "jsCode": "const s = $input.first().json;\nconst { curso_extra, aulas_extras } = s.beneficios;\nconst response = {\n  success: true,\n  email: s.email,\n  cupom: s.cupom,\n  affiliate_id: s.affiliate_id,\n  hubspot_contact_id: s.hubspot_contact_id,\n  beneficios: {\n    curso_extra: { ...curso_extra, status: s.curso_status },\n    aulas_extras: { ...aulas_extras, status: s.aulas_status },\n  },\n};\nconst log = {\n  timestamp: new Date().toISOString(),\n  email: s.email,\n  cupom: s.cupom,\n  affiliate_id: s.affiliate_id,\n  hubspot_contact_id: s.hubspot_contact_id,\n  curso_extra_codigo: curso_extra.liberar ? curso_extra.codigo : '',\n  curso_status: s.curso_status,\n  qtd_aulas_extras: aulas_extras.liberar ? aulas_extras.quantidade : '',\n  aulas_status: s.aulas_status,\n  resultado: 'success',\n  erro: '',\n};\nreturn [{ json: { response, log } }];"
