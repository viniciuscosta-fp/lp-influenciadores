    {
      "parameters": {
        "jsCode": "// PLACEHOLDER: liberação de aulas particulares extras.\n// Quando a forma de liberação estiver definida, inserir antes deste nó um\n// HTTP Request e ajustar aulas_status conforme a resposta ('released' ou 'failed').\n// Dados disponíveis: $json.email, $json.hubspot_contact_id,\n// $json.beneficios.aulas_extras.quantidade\nconst cfg = $('Config').first().json;\nconst s = $input.first().json;\nconst qtd = s.beneficios.aulas_extras.quantidade;\nconst props = { ...s.hubspot_properties };\n\n// Opcional: registra a quantidade pendente no HubSpot (somando ao valor atual)\nif (cfg.hubspot_prop_aulas_pendentes) {\n  const atual = parseInt((s.contact_props || {})[cfg.hubspot_prop_aulas_pendentes], 10) || 0;\n  props[cfg.hubspot_prop_aulas_pendentes] = String(atual + qtd);\n}\nreturn [{ json: { ...s, hubspot_properties: props, aulas_status: 'pending' } }];"
      },
