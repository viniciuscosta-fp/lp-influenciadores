      "parameters": {
        "jsCode": "// Normaliza e valida o payload recebido no webhook\nconst body = $('Webhook').first().json.body || {};\nconst email = String(body.email || '').trim().toLowerCase();\nconst cupom = String(body.cupom || '').trim().toUpperCase().replace(/\\s+/g, '');\nconst acquire_url = String(body.acquireUrl || body.acquire_url || '').trim();\n\nconst erros = [];\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) erros.push('email ausente ou inválido');\nif (!cupom) erros.push('cupom ausente');\n\nreturn [{\n  json: {\n    ok: erros.length === 0,\n    http_status: erros.length ? 400 : null,\n    reason: erros.length ? 'INVALID_PAYLOAD' : null,\n    message: erros.join('; ') || null,\n    email,\n    cupom,\n    acquire_url,\n  },\n}];"
      },
