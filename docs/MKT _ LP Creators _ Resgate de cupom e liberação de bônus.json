    {
      "parameters": {
        "jsCode": "// Liberação do curso extra: adiciona a propriedade do curso ao PATCH do contato.\n// A gravação efetiva acontece no nó HubSpot PATCH Contact.\nconst cfg = $('Config').first().json;\nconst s = $input.first().json;\nconst codigo = s.beneficios.curso_extra.codigo;\nconst atual = s.contact_props || {};\nconst props = { ...s.hubspot_properties };\n\nif (cfg.hubspot_prop_curso_multi) {\n  // multi-seleção: acrescenta o curso sem remover os que o contato já tem\n  const lista = String(atual[cfg.hubspot_prop_curso] || '').split(';').map(v => v.trim()).filter(Boolean);\n  if (!lista.includes(codigo)) lista.push(codigo);\n  props[cfg.hubspot_prop_curso] = lista.join(';');\n} else {\n  props[cfg.hubspot_prop_curso] = codigo;\n}\nreturn [{ json: { ...s, hubspot_properties: props } }];"
      },
